# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log

# env files (can opt-in for committing if needed)
.env*
# Wrangler's local secrets file is named `.dev.vars`, which `.env*` does NOT
# match. Without this line a local OpenRouter key would be committed silently.
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# local tooling / agent config (contains machine-specific absolute paths)
.mcp.json
.claude/

# editors / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/

# os misc
.DS_Store
Thumbs.db

# render scratch: thousands of PNG frames, not a deliverable
submission/video/frames/
